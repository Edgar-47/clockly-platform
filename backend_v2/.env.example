# ============================================================
# CLOCKLY BACKEND — PRODUCTION ENVIRONMENT REFERENCE
# ============================================================
# This file documents required variables. NEVER put real secrets here.
# Real values must be injected via:
#   fly secrets set KEY=VALUE --app clockly-api
# or via a local .env file (git-ignored).
#
# IMPORTANT: If you see real credentials here, rotate them immediately.
# ============================================================

# ── App ─────────────────────────────────────────────────────
CLOCKLY_ENV=production
CLOCKLY_VERSION=0.1.0
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
CLOCKLY_SECRET_KEY=<change-me-min-64-chars>
CLOCKLY_LOG_FORMAT=json
CLOCKLY_DEBUG=false

# ── Database (Neon PostgreSQL) ───────────────────────────────
# Use the Neon pooler endpoint for best results:
#   ep-xxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require
# Direct endpoint works too but limits concurrent connections.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# DB connection pool (tune to your Neon plan's connection limit)
# Neon Free: pool_size=3, max_overflow=2
# Neon Launch + pooler: pool_size=10, max_overflow=20
CLOCKLY_DB_POOL_SIZE=5
CLOCKLY_DB_MAX_OVERFLOW=10

# ── Security / CORS ──────────────────────────────────────────
CLOCKLY_CORS_ALLOWED_ORIGINS=https://app.clockly.es
# Add the Fly app domain and internal hostname.
# If you rename the Fly app, update clockly-api.fly.dev and clockly-api.internal accordingly.
CLOCKLY_TRUSTED_HOSTS=api.clockly.es,clockly-api.fly.dev,clockly-api.internal
CLOCKLY_FRONTEND_BASE_URL=https://app.clockly.es
CLOCKLY_TRUST_PROXY_HEADERS=true

# ── Auth tokens ──────────────────────────────────────────────
CLOCKLY_ACCESS_TOKEN_MINUTES=15
CLOCKLY_REFRESH_TOKEN_DAYS=30

# ── Rate limiting (Upstash Redis) ────────────────────────────
CLOCKLY_RATE_LIMIT_ENABLED=true
CLOCKLY_RATE_LIMIT_BACKEND=redis
# Upstash uses rediss:// (SSL). Get from Upstash dashboard.
CLOCKLY_REDIS_URL=rediss://default:PASSWORD@HOST:PORT
CLOCKLY_RATE_LIMIT_KEY_PREFIX=clockly:rate-limit

# ── File storage (Cloudflare R2) ─────────────────────────────
CLOCKLY_STORAGE_BACKEND=r2
CLOCKLY_S3_BUCKET=clockly-prod-uploads
# Format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
CLOCKLY_S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
CLOCKLY_S3_ACCESS_KEY_ID=<R2-access-key-id>
CLOCKLY_S3_SECRET_ACCESS_KEY=<R2-secret-access-key>
CLOCKLY_S3_REGION=auto

# ── Transactional email (Resend) ─────────────────────────────
CLOCKLY_EMAIL_PROVIDER=resend
CLOCKLY_EMAIL_FROM=ClockLy <no-reply@notify.clockly.es>
CLOCKLY_EMAIL_RESEND_API_KEY=re_<your-resend-api-key>
CLOCKLY_EMAIL_RESEND_API_URL=https://api.resend.com/emails

# SMTP (alternative — only if not using Resend)
CLOCKLY_EMAIL_SMTP_HOST=
CLOCKLY_EMAIL_SMTP_PORT=587
CLOCKLY_EMAIL_SMTP_USERNAME=
CLOCKLY_EMAIL_SMTP_PASSWORD=
CLOCKLY_EMAIL_SMTP_USE_TLS=true
CLOCKLY_EMAIL_SMTP_TIMEOUT_SECONDS=10

# ── Stripe billing ───────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_<your-stripe-secret-key>
STRIPE_WEBHOOK_SECRET=whsec_<your-webhook-signing-secret>
STRIPE_PRICE_PRO=price_<pro-plan-price-id>
STRIPE_PRICE_BUSINESS=price_<business-plan-price-id>
CLOCKLY_BILLING_SUCCESS_URL=https://app.clockly.es/settings?billing=success
CLOCKLY_BILLING_CANCEL_URL=https://app.clockly.es/upgrade?billing=cancelled

# ── Observability (optional) ─────────────────────────────────
SENTRY_DSN=
CLOCKLY_SENTRY_TRACES_SAMPLE_RATE=0.05
