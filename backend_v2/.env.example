CLOCKLY_ENV=development
CLOCKLY_SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://clockly:clockly@localhost:5432/clockly
CLOCKLY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CLOCKLY_TRUSTED_HOSTS=localhost,127.0.0.1,testserver
CLOCKLY_ACCESS_TOKEN_MINUTES=15
CLOCKLY_REFRESH_TOKEN_DAYS=30

# Rate limiting
CLOCKLY_RATE_LIMIT_ENABLED=true
CLOCKLY_RATE_LIMIT_BACKEND=memory
CLOCKLY_REDIS_URL=
CLOCKLY_RATE_LIMIT_KEY_PREFIX=clockly:rate-limit

# Transactional email. Local/dev defaults to noop and still returns acceptance_url.
CLOCKLY_EMAIL_PROVIDER=noop
CLOCKLY_EMAIL_FROM=
CLOCKLY_EMAIL_SMTP_HOST=
CLOCKLY_EMAIL_SMTP_PORT=587
CLOCKLY_EMAIL_SMTP_USERNAME=
CLOCKLY_EMAIL_SMTP_PASSWORD=
CLOCKLY_EMAIL_SMTP_USE_TLS=true
CLOCKLY_EMAIL_SMTP_TIMEOUT_SECONDS=10
