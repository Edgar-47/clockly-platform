CLOCKLY_ENV=development
CLOCKLY_VERSION=0.1.0
CLOCKLY_SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://clockly:clockly@localhost:5432/clockly
CLOCKLY_LOG_FORMAT=console
SENTRY_DSN=
CLOCKLY_SENTRY_TRACES_SAMPLE_RATE=0
CLOCKLY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CLOCKLY_TRUSTED_HOSTS=localhost,127.0.0.1,testserver
CLOCKLY_FRONTEND_BASE_URL=http://localhost:3000
CLOCKLY_ACCESS_TOKEN_MINUTES=15
CLOCKLY_REFRESH_TOKEN_DAYS=30
CLOCKLY_TRUST_PROXY_HEADERS=false

# Rate limiting
CLOCKLY_RATE_LIMIT_ENABLED=true
CLOCKLY_RATE_LIMIT_BACKEND=redis
CLOCKLY_REDIS_URL=redis://localhost:6379/0
CLOCKLY_RATE_LIMIT_KEY_PREFIX=clockly:rate-limit

# Transactional email.
# Local/dev can use noop; the email body is logged for development fallback.
# Production rejects noop. Configure SMTP or another supported adapter before going live.
CLOCKLY_EMAIL_PROVIDER=noop
CLOCKLY_EMAIL_FROM=
CLOCKLY_EMAIL_SMTP_HOST=
CLOCKLY_EMAIL_SMTP_PORT=587
CLOCKLY_EMAIL_SMTP_USERNAME=
CLOCKLY_EMAIL_SMTP_PASSWORD=
CLOCKLY_EMAIL_SMTP_USE_TLS=true
CLOCKLY_EMAIL_SMTP_TIMEOUT_SECONDS=10
CLOCKLY_EMAIL_RESEND_API_KEY=
CLOCKLY_EMAIL_RESEND_API_URL=https://api.resend.com/emails

# Stripe Billing (subscriptions via Checkout + Customer Portal)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
CLOCKLY_BILLING_SUCCESS_URL=http://localhost:3000/settings?billing=success
CLOCKLY_BILLING_CANCEL_URL=http://localhost:3000/upgrade?billing=cancelled
